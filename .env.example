# Option A — cloud inventory + login (recommended for multi-device)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Option B — host login + browser storage (works without Supabase)
VITE_HOST_EMAIL=you@example.com
VITE_HOST_PASSWORD=choose-a-strong-password
